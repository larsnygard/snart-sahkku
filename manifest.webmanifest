{
  "name": "SnartSáhkku — Lágesvuotna-sáhkku",
  "short_name": "Sáhkku",
  "description": "Det gamle samiske spillet sáhkku fra Laksefjorden: spill mot CPU eller over nett (iroh P2P).",
  "lang": "nb",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c1730",
  "theme_color": "#0c1730",
  "categories": [
    "games",
    "entertainment"
  ],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "label": "Sáhkku-brett"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/x-sahkku-spg",
            ".spg",
            ".spgz",
            ".zip",
            "application/json",
            "text/plain",
            "image/png",
            "image/jpeg",
            ".png",
            ".jpg",
            ".jpeg"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-sahkku-spg": [
          ".spg",
          ".spgz"
        ],
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ]
      }
    }
  ]
}
